# Copy to .env.local for local development, and set the same names in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Public address of the site (used in sitemap, social previews). Optional on Vercel previews.
NEXT_PUBLIC_SITE_URL=https://www.odysseyventures.llc
# "true" lets search engines index the site. Leave unset on previews.
NEXT_PUBLIC_ALLOW_INDEXING=

# Google Apps Script web app that saves form submissions to the operations sheet.
# Without these two, forms open the visitor's email app instead (nothing is lost).
SUBMISSIONS_WEBHOOK_URL=
SUBMISSIONS_WEBHOOK_SECRET=

# "Programs" tab of the operations sheet, published as CSV (File → Share → Publish to web).
# Without it, Academy shows src/data/programs.ts (and labeled samples outside production).
PROGRAMS_CSV_URL=

# Supabase project (Project Settings → API) for the Newsroom and Customer Support boards and email login.
# Without these, Newsroom shows "coming soon" and Customer Support points to the Contact page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 1:1 advisor meeting payment buttons (non-members and the basic membership tier).
# Payment page links, e.g. Stripe Payment Links (https only). Without a link, the button shows "payment coming soon".
ADVISORY_PAYMENT_URL_GUEST=
ADVISORY_PAYMENT_URL_MEMBER=
# Price shown on each button, written as you want it to appear, e.g. "$150 / 45 min". Optional.
ADVISORY_PRICE_GUEST=
ADVISORY_PRICE_MEMBER=

# Paid Academy sessions (Programs sheet "price"): payment page used when a session has no "payment_url" of its own,
# e.g. a Stripe Payment Link. Without either, paid sessions take registrations and payment is arranged by email.
ACADEMY_PAYMENT_URL=
