# Copy to .env.local for local development, and set the same names in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Public address of the site (used in sitemap, social previews). Optional on Vercel previews.
NEXT_PUBLIC_SITE_URL=https://www.odysseyventures.llc
# "true" lets search engines index the site. Leave unset on previews.
NEXT_PUBLIC_ALLOW_INDEXING=

# Google Apps Script web app that saves form submissions to the operations sheet.
# Without these two, forms open the visitor's email app instead (nothing is lost).
SUBMISSIONS_WEBHOOK_URL=
SUBMISSIONS_WEBHOOK_SECRET=

# "Programs" tab of the operations sheet, published as CSV (File → Share → Publish to web).
# Without it, Academy shows src/data/programs.ts (and labeled samples outside production).
PROGRAMS_CSV_URL=
